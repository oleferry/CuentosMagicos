# Clave de la API de OpenAI (obligatoria para generar cuentos e imágenes)
# Consíguela en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Contraseña de acceso al sitio (opcional).
# Si la defines, la web pedirá esta contraseña para entrar (protege la IA y evita costes).
# Si la dejas vacía o sin definir, el sitio queda abierto a cualquiera.
SITE_PASSWORD=
