# Clave de la API de OpenAI (obligatoria para generar cuentos e imágenes)
# Consíguela en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Contraseña de la "llave de familia": en /familia da cuentos ilimitados.
SITE_PASSWORD=

# Base de datos para los límites y los emails (Upstash Redis).
# Al conectar Upstash desde Vercel (Storage) se rellenan solas. Sin ellas,
# la versión pública queda cerrada (solo funciona el acceso de familia).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Límites de la versión pública (opcionales; estos son los valores por defecto).
LIMITE_SIN_EMAIL=2
LIMITE_CON_EMAIL=10
LIMITE_GLOBAL_DIA=50
